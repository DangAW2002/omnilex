---
import fs from 'node:fs';
import path from 'node:path';
import { micromark } from 'micromark';
import viI18n from '../../../i18n/vi.json';
import enI18n from '../../../i18n/en.json';

export function getStaticPaths() {
  const rootDir = path.resolve(process.cwd(), '../../');
  const conceptsDir = path.join(rootDir, 'concepts');
  const conceptIds = fs.existsSync(conceptsDir)
    ? fs.readdirSync(conceptsDir, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name)
    : [];

  const paths = [];
  for (const locale of ['vi', 'en']) {
    for (const id of conceptIds) {
      paths.push({ params: { locale, id } });
    }
  }
  return paths;
}

const { locale, id } = Astro.params;
const basePath = import.meta.env.BASE_URL;
const rootDir = path.resolve(process.cwd(), '../../');
const distConceptFile = path.join(rootDir, 'dist', locale, 'concepts', `${id}.json`);
const fallbackDistFile = path.join(rootDir, 'dist', 'en', 'concepts', `${id}.json`);

let metadata: any = { id, domains: [], level: 1, status: 'draft', relations: {} };
let frontmatter: any = { label: id, plain_descriptions: [], summary: '', confusable_notes: {}, follow_up_questions: [] };
let bodyContent = '';
let contentLocale = locale;

const activeJsonFile = fs.existsSync(distConceptFile) ? distConceptFile : fallbackDistFile;
if (fs.existsSync(activeJsonFile)) {
  const data = JSON.parse(fs.readFileSync(activeJsonFile, 'utf-8'));
  metadata = data.metadata || metadata;
  frontmatter = data.entry?.frontmatter || frontmatter;
  bodyContent = data.entry?.content || '';
  contentLocale = data.content_locale || locale;
}

const strings = locale === 'vi' ? viI18n : enI18n;
const bodyHtml = micromark(bodyContent);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.label} — Termbridge</title>
    <style>
      :root {
        --bg: #0f172a;
        --card-bg: #1e293b;
        --text: #f8fafc;
        --text-muted: #94a3b8;
        --primary: #38bdf8;
        --border: #334155;
      }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .container {
        max-width: 760px;
        width: 100%;
      }
      a.back {
        color: var(--primary);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 1.5rem;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
      }
      h1 {
        font-size: 2.25rem;
        margin: 0 0 0.5rem 0;
        color: var(--primary);
      }
      .meta {
        font-size: 0.875rem;
        color: var(--text-muted);
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }
      .summary-box {
        background: #1e293b;
        border-left: 4px solid var(--primary);
        padding: 1rem 1.25rem;
        border-radius: 0.5rem;
        margin-bottom: 2rem;
        font-size: 1.1rem;
      }
      .section {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .section h2 {
        margin-top: 0;
        color: #e2e8f0;
        font-size: 1.25rem;
      }
      .content-body {
        line-height: 1.7;
        color: #cbd5e1;
        overflow-wrap: anywhere;
      }
      .content-body h2 { color: #e2e8f0; margin-top: 1.6rem; }
      .content-body p, .content-body li { line-height: 1.7; }
      .draft-note { color: #ffd18b; }
      .related-links { display: flex; gap: .75rem; flex-wrap: wrap; }
      .related-links a { color: var(--primary); }
      .prompt-box {
        background: #020617;
        border: 1px dashed #475569;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-top: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href={`${basePath}${locale}/`} class="back">← {locale === 'vi' ? 'Quay lại tìm kiếm' : 'Back to search'}</a>

      <header>
        <h1>{frontmatter.label} {frontmatter.qualifier && <small style="color: var(--text-muted); font-size: 1.2rem;">{frontmatter.qualifier}</small>}</h1>
        <div class="meta">
          <span><strong>ID:</strong> {id}</span>
          <span><strong>{locale === 'vi' ? 'Độ khó' : 'Level'}:</strong> {metadata.level}</span>
          <span><strong>{locale === 'vi' ? 'Trạng thái' : 'Status'}:</strong> {metadata.status === 'draft' ? strings.provenance_draft : metadata.status === 'reviewed' ? strings.provenance_reviewed : metadata.status === 'verified' ? strings.provenance_verified : metadata.status}</span>
          <span><strong>{locale === 'vi' ? 'Lĩnh vực' : 'Domains'}:</strong> {metadata.domains?.join(', ')}</span>
        </div>
      </header>

      {metadata.status === 'draft' && <p class="draft-note">{strings.provenance_draft}</p>}
      {contentLocale !== locale && <p class="draft-note">{locale === 'vi' ? `Chưa có bản tiếng Việt; đang hiển thị bản ${contentLocale}.` : `This entry is displayed in ${contentLocale}.`}</p>}

      <div class="summary-box">
        <strong>{locale === 'vi' ? 'Tóm tắt:' : 'Summary:'}</strong> {frontmatter.summary}
      </div>

      <div class="section">
        <h2>{locale === 'vi' ? 'Giải thích chi tiết theo tầng' : 'Layered Explanation'}</h2>
        <div class="content-body">
          <Fragment set:html={bodyHtml} />
        </div>
      </div>

      {metadata.relations?.prerequisites?.length > 0 && (
        <div class="section">
          <h2>{strings.prerequisites}</h2>
          <div class="related-links">{metadata.relations.prerequisites.map((relatedId: string) => <a href={`${basePath}${locale}/c/${relatedId}/`}>{relatedId}</a>)}</div>
        </div>
      )}

      {Object.keys(frontmatter.confusable_notes || {}).length > 0 && (
        <div class="section">
          <h2>{strings.confusables}</h2>
          <ul>{Object.entries(frontmatter.confusable_notes).map(([relatedId, note]) => <li><a href={`${basePath}${locale}/c/${relatedId}/`}>{relatedId}</a>: {String(note)}</li>)}</ul>
        </div>
      )}

      {frontmatter.follow_up_questions?.length > 0 && (
        <div class="section">
          <h2>{strings.follow_up_prompt}</h2>
          <ul>
            {frontmatter.follow_up_questions.map((q: string) => (
              <li>
                <div class="prompt-box">
                  <code>{q}</code>
                  <button type="button" data-copy-prompt={q}>{strings.copy_prompt}</button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <script>
      document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copyPrompt || '');
          button.textContent = document.documentElement.lang === 'vi' ? 'Đã sao chép' : 'Copied';
        });
      });
    </script>
  </body>
</html>
