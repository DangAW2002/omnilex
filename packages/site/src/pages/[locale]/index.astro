---
import viI18n from '../../i18n/vi.json';
import enI18n from '../../i18n/en.json';

export function getStaticPaths() {
  return [{ params: { locale: 'vi' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params;
const strings = locale === 'vi' ? viI18n : enI18n;
const basePath = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{strings.site_title}</title>
    <style>
      :root { font-family: system-ui, sans-serif; color: #e8edf5; background: #0d1524; }
      * { box-sizing: border-box; }
      body { margin: 0; }
      main { max-width: 900px; margin: auto; padding: 2rem 1.25rem 5rem; }
      nav { display: flex; justify-content: flex-end; gap: 1rem; }
      a { color: #77d3f5; }
      nav a[aria-current="page"] { color: white; font-weight: 700; }
      header { padding: 3rem 0 2rem; }
      h1 { font-size: clamp(2.5rem, 7vw, 4rem); letter-spacing: -.04em; margin: 0; }
      header p { max-width: 640px; color: #b7c7d9; font-size: 1.15rem; line-height: 1.6; }
      .search { display: grid; grid-template-columns: 1fr auto; gap: .75rem; }
      input, select { background: #17263a; color: white; border: 1px solid #456077; border-radius: .65rem; padding: .85rem 1rem; font: inherit; }
      input { width: 100%; }
      input:focus, select:focus { outline: 2px solid #77d3f5; outline-offset: 2px; }
      .hint { color: #aabdd0; font-size: .9rem; margin: 1rem 0 2rem; }
      .results { display: grid; gap: .85rem; }
      .result { display: block; color: inherit; text-decoration: none; background: #17263a; border: 1px solid #334b63; border-radius: .8rem; padding: 1.15rem 1.3rem; }
      .result:hover, .result:focus { border-color: #77d3f5; }
      .result h3 { color: #83d8f6; margin: 0 0 .4rem; }
      .result p { color: #d1dce9; line-height: 1.5; margin: .35rem 0; }
      .meta { color: #aabdd0; font-size: .85rem; }
      .draft { color: #ffd18b; }
      @media (max-width: 600px) { .search { grid-template-columns: 1fr; } header { padding-top: 2rem; } }
    </style>
  </head>
  <body>
    <main id="app" data-locale={locale} data-base={basePath}>
      <nav aria-label={locale === 'vi' ? 'Ngôn ngữ' : 'Languages'}>
        <a href={`${basePath}vi/`} aria-current={locale === 'vi' ? 'page' : undefined}>Tiếng Việt</a>
        <a href={`${basePath}en/`} aria-current={locale === 'en' ? 'page' : undefined}>English</a>
      </nav>
      <header>
        <h1>Termbridge</h1>
        <p>{locale === 'vi' ? 'Mô tả điều bạn muốn nói để tìm đúng thuật ngữ, hoặc chọn một khái niệm để đọc giải thích.' : 'Describe an idea in plain words to find the right term, or browse a concept to learn more.'}</p>
      </header>
      <div class="search">
        <input id="search-input" type="search" autocomplete="off" placeholder={strings.search_placeholder} aria-label={strings.search_button} />
        <select id="domain-select" aria-label={strings.select_domain}>
          <option value="">{strings.select_domain}</option>
          <option value="finance">{locale === 'vi' ? 'Tài chính' : 'Finance'}</option>
          <option value="media">Media</option>
          <option value="it">{locale === 'vi' ? 'Công nghệ thông tin' : 'IT'}</option>
        </select>
      </div>
      <p class="hint" id="result-count" aria-live="polite"></p>
      <section class="results" id="results" aria-label={locale === 'vi' ? 'Kết quả tra cứu' : 'Search results'}></section>
    </main>
    <script>
      import type MiniSearch from 'minisearch';
      import { domainMatches, loadSearchIndex, searchIndexes } from '@termbridge/core/dist/search-config.js';

      const app = document.querySelector<HTMLElement>('#app')!;
      const input = document.querySelector<HTMLInputElement>('#search-input')!;
      const domainSelect = document.querySelector<HTMLSelectElement>('#domain-select')!;
      const results = document.querySelector<HTMLElement>('#results')!;
      const count = document.querySelector<HTMLElement>('#result-count')!;
      const locale = app.dataset.locale || 'vi';
      const base = app.dataset.base || '/';

      // Shards are fetched on first use: the combined index for queries, the
      // cards of every content pack for browsing without a query.
      const fetchText = (file: string) => fetch(`${base}data/${file}`).then((res) => res.text());
      let manifest: Promise<any> | null = null;
      let index: Promise<MiniSearch> | null = null;
      let cards: Promise<any[]> | null = null;
      const getManifest = () => (manifest ||= fetchText('manifest.json').then(JSON.parse));
      const getIndex = () => (index ||= fetchText(`${locale}/search-index.json`).then((json) => loadSearchIndex(json)));
      const getCards = () => (cards ||= getManifest()
        .then((m) => Promise.all(
          m.packs
            .filter((pack: any) => pack.kind === 'content')
            .map((pack: any) => fetchText(`packs/${pack.id}/${locale}/cards.json`).then(JSON.parse))
        ))
        .then((lists) => lists.flat()));

      let drawId = 0;

      async function draw() {
        const current = ++drawId;
        const query = input.value.trim();
        const domain = domainSelect.value;
        const filtered: any[] = query
          ? searchIndexes([await getIndex()], query, { domain, limit: 10 })
          : (await getCards())
              .filter((entry: any) => !domain || entry.domains.some((path: string) => domainMatches(path, domain)))
              .slice(0, 12);
        if (current !== drawId) return;

        count.textContent = query
          ? (locale === 'vi' ? `${filtered.length} kết quả phù hợp` : `${filtered.length} matching results`)
          : (locale === 'vi' ? `${filtered.length} khái niệm` : `${filtered.length} concepts`);
        results.replaceChildren();
        for (const entry of filtered) {
          const link = document.createElement('a');
          link.className = 'result';
          link.href = `${base}${locale}/c/${encodeURIComponent(entry.id)}/`;
          const title = document.createElement('h3');
          title.textContent = `${entry.label}${entry.qualifier ? ` ${entry.qualifier}` : ''}`;
          const summary = document.createElement('p');
          summary.textContent = entry.summary;
          const meta = document.createElement('div');
          meta.className = 'meta';
          meta.textContent = `${entry.domains.join(' · ')} · ${entry.status}`;
          if (entry.status === 'draft') meta.classList.add('draft');
          link.append(title, summary, meta);
          results.append(link);
        }
      }

      input.addEventListener('input', draw);
      domainSelect.addEventListener('change', draw);
      draw();
    </script>
  </body>
</html>
