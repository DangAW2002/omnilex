{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnilex.org/schema/locale-entry.schema.json",
  "title": "OmniLex Locale Entry Schema",
  "type": "object",
  "required": ["label", "plain_descriptions", "summary"],
  "properties": {
    "label": {
      "type": "string",
      "description": "Canonical terminology label in this locale"
    },
    "qualifier": {
      "type": "string",
      "description": "Short disambiguation qualifier when label collides (e.g., '(AI)', '(finance)')"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names or acronyms"
    },
    "loanwords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Loanwords commonly retained untranslated in this locale"
    },
    "plain_descriptions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Colloquial/plain descriptions used for reverse lookups"
    },
    "summary": {
      "type": "string",
      "description": "Single-sentence plain summary"
    },
    "confusable_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Keyed by confusable concept ID, explaining the specific distinction"
    },
    "follow_up_questions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Suggested follow-up prompt questions for AI"
    },
    "translation": {
      "type": "string",
      "enum": ["native", "translated", "machine"]
    },
    "translated_from": {
      "type": "string"
    },
    "translated_by": {
      "type": "string"
    },
    "translated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "coined": {
      "type": "boolean"
    },
    "autolink": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "enum": ["always", "never", "auto"] },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["always", "never", "auto"] }
        }
      },
      "additionalProperties": false
    },
    "label_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "locator"],
        "properties": {
          "ref": { "type": "string" },
          "locator": { "type": "string" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["ref", "locator", "accessed", "language"],
            "properties": {
              "ref": { "type": "string" },
              "locator": { "type": "string" },
              "title": { "type": "string" },
              "language": { "type": "string" },
              "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "retrieved_by": { "type": "string", "enum": ["ai", "human"] },
              "supports": {
                "type": "array",
                "items": { "type": "string", "enum": ["definition", "summary", "example"] }
              },
              "quote": { "type": "string" },
              "archive": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
