{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://termbridge.org/schema/taxonomy.schema.json",
  "title": "Termbridge Taxonomy Tree Schema",
  "type": "object",
  "required": ["id", "labels"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "children": {
      "type": "array",
      "items": { "$ref": "#" }
    }
  },
  "additionalProperties": false
}
